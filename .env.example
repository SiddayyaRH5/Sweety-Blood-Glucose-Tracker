# Server listening port & environment
PORT=3000
NODE_ENV=development

# PostgreSQL connection (local PostgreSQL or Neon PostgreSQL)
# Local example: postgresql://postgres:postgres@localhost:5432/sweety
# Neon example:  postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/sweety?sslmode=require
DATABASE_URL=
DATABASE_SSL=false
PG_POOL_MAX=10

# Optional discrete PostgreSQL credentials (used only if DATABASE_URL is empty)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=sweety

# Optional separate PostgreSQL URL for live DB integration tests
# TEST_DATABASE_URL=

# JWT signing configuration (replace with a strong random secret in production)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Server-side Gemini AI key (never expose to client)
GEMINI_API_KEY=

# Application & CORS configuration
APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend API base URL (set to your deployed backend /api URL when deploying separately)
VITE_API_BASE_URL=http://localhost:3000/api
